# Auth Service Environment Variables
# 本地调试：复制为项目根目录 .env 并填入真实值（spring-dotenv 自动加载，环境变量可覆盖）
# 服务器部署：直接编辑 docker-compose.yml 中 environment 的 your_* 占位值，无需 .env

# Database
DB_URL=jdbc:mysql://127.0.0.1:3306/auth_service?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_db_password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT Secret (256-bit Base64 encoded, at least 32 bytes)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# Login method credential encryption (AES Base64 key, 16/24/32 bytes)
# Used to encrypt email/sms/oauth credentials stored in login_method_config.config_json
# Generate with: openssl rand -base64 32
LOGIN_CONFIG_AES_KEY=your_login_config_aes_key_here

# RPC Service Token (for inter-service Dubbo authentication; empty = skip auth)
RPC_SERVICE_TOKEN=your_rpc_service_token_here

# Nacos (registry & metadata report)
NACOS_ADDRESS=nacos://127.0.0.1:8848
# Nacos 开启鉴权时填写；未开启鉴权可留空
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# Aliyun OSS (头像上传；不配置则上传接口不可用)
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=your_bucket_name
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_OBJECT_PREFIX=avatar
